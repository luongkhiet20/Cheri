# ============================================================================
# CHERI MACHINE LEARNING MODULE - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to .env and configure with your actual MongoDB credentials.
# DO NOT COMMIT THE ACTUAL .env FILE TO GIT.

# MongoDB Connection String (Atlas or Local)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/cheri?retryWrites=true&w=majority
MONGO_DB_NAME=cheri

# Output Directories (relative to server/ml or absolute paths)
OUTPUT_DATA_DIR=./data
OUTPUT_REPORT_DIR=./reports

# Prediction Target Configuration
# Window size in days to observe future purchase/interaction (Default: 14 days)
FUTURE_WINDOW_DAYS=14

# Minimum interactions threshold for user filtering
MIN_INTERACTIONS=1
