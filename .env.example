# ==============================================================================
# Environment Configuration Template for Chéri Fashion
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the actual .env file to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Ports (Docker / Runtime)
# ------------------------------------------------------------------------------
PORT=4000
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=your-supported-model-id
ADMIN_PORT=5000
SERVER_URL="http://localhost:4000"
ORIGIN="http://localhost:3000"

# ------------------------------------------------------------------------------
# Database (MongoDB Atlas Cloud or Local MongoDB)
# ------------------------------------------------------------------------------
# For MongoDB Atlas Cloud (Default):
MONGO_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/cheri?retryWrites=true&w=majority"
# For Local MongoDB via Docker Compose profile (--profile local-db):
# MONGO_URI="mongodb://mongo:27017/cheri"

# ------------------------------------------------------------------------------
# Security & Authentication Secrets
# ------------------------------------------------------------------------------
JWT_SECRET="replace-with-a-very-strong-jwt-secret-key-at-least-32-chars"
JWT_EXPIRATION="7d"
COOKIE_KEY="replace-with-a-random-cookie-encryption-key"
PASSWORD_RESET_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# ------------------------------------------------------------------------------
# Notifications & Emails (SendGrid)
# ------------------------------------------------------------------------------
ADMIN_EMAILS="contact.cheri@gmail.com,admin@example.com"
SENDGRID_KEY="SG.your-actual-sendgrid-api-key"
EMAIL_FROM="contact@cheri.vn"

# ------------------------------------------------------------------------------
# Cloudinary Media Storage (Product & Proof Images)
# ------------------------------------------------------------------------------
CLOUDINARY_NAME="your-cloudinary-cloud-name"
CLOUDINARY_KEY="your-cloudinary-api-key"
CLOUDINARY_SECRET="your-cloudinary-api-secret"

# ------------------------------------------------------------------------------
# Payment Gateways (Stripe)
# ------------------------------------------------------------------------------
STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
STRIPE_SECRETKEY="sk_test_your-stripe-secret-key"

# ------------------------------------------------------------------------------
# Google OAuth 2.0 (Social Sign-in)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# ------------------------------------------------------------------------------
# Captcha & External Services
# ------------------------------------------------------------------------------
RECAPTCHA_SERVER_KEY="your-google-recaptcha-secret-key"
GEO_LOCATION_API_KEY="your-geolocation-api-key"

# ------------------------------------------------------------------------------
# Frontend Client Exposed Keys
# ------------------------------------------------------------------------------
FE_STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
FE_TINYMCE_API_KEY="your-tinymce-api-key"
FE_RECAPTCHA_CLIENT_KEY="your-recaptcha-site-key"
FE_ANALYTICS_TOKEN="G-XXXXXXXXXX"
