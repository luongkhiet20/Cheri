# ==============================================================================
# Environment Configuration Template for Chéri Fashion
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the actual .env file to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Ports (Backend & Admin)
# ------------------------------------------------------------------------------
PORT=4000
ADMIN_PORT=5001
SERVER_URL="http://localhost:4000"
LOCAL_SERVER_URL="http://localhost:4000"

# ------------------------------------------------------------------------------
# Frontend Host / CORS Allowed Origins (Comma-separated for multiple origins)
# ------------------------------------------------------------------------------
ORIGIN="http://localhost:3000,https://your-frontend-domain.vercel.app"

# ------------------------------------------------------------------------------
# Security & Authentication Secrets
# ------------------------------------------------------------------------------
JWT_EXPIRATION="7d"
JWT_SECRET="replace-with-a-very-strong-jwt-secret-key-at-least-32-chars"
COOKIE_KEY="replace-with-a-random-cookie-encryption-key"
PASSWORD_RESET_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# ------------------------------------------------------------------------------
# Database (MongoDB Atlas Cloud or Local MongoDB)
# ------------------------------------------------------------------------------
# For MongoDB Atlas Cloud (Default):
MONGO_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/cheri?retryWrites=true&w=majority"
# For Local MongoDB via Docker Compose profile (--profile local-db):
# MONGO_URI="mongodb://mongo:27017/cheri"

# ------------------------------------------------------------------------------
# Notifications & Emails (SendGrid)
# ------------------------------------------------------------------------------
ADMIN_EMAILS="contact.cheri@gmail.com,admin@example.com"
SENDGRID_KEY="SG.your-actual-sendgrid-api-key"
EMAIL_FROM="your-verified-sender@example.com"

# ------------------------------------------------------------------------------
# Cloudinary Media Storage (Product & Proof Images)
# ------------------------------------------------------------------------------
CLOUDINARY_NAME="your-cloudinary-cloud-name"
CLOUDINARY_KEY="your-cloudinary-api-key"
CLOUDINARY_SECRET="your-cloudinary-api-secret"

# ------------------------------------------------------------------------------
# Payment Gateways - Stripe
# ------------------------------------------------------------------------------
STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
STRIPE_SECRETKEY="sk_test_your-stripe-secret-key"

# ------------------------------------------------------------------------------
# Payment Gateways - VNPay (Sandbox / Production)
# ------------------------------------------------------------------------------
VNPAY_TMN_CODE="your-vnpay-tmn-code"
VNPAY_HASH_SECRET="your-vnpay-hash-secret"
VNPAY_PAYMENT_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL="https://your-public-backend.example.com/api/orders/payment/vnpay/return"
VNPAY_IPN_URL="https://your-public-backend.example.com/api/orders/payment/vnpay/ipn"
VNPAY_QUERY_URL="https://sandbox.vnpayment.vn/merchant_webapi/api/transaction"
VNPAY_RECONCILE_ENABLED=false

# Aliases (tương thích backward)
VNP_TMN_CODE="your-vnpay-tmn-code"
VNP_HASH_SECRET="your-vnpay-hash-secret"
VNP_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNP_API_URL="https://sandbox.vnpayment.vn/merchant_webapi/api/transaction"
VNP_RETURN_URL="https://your-public-backend.example.com/api/orders/payment/vnpay/return"

# VNPAY Sandbox Test Card Credentials:
# Bank: NCB | Card Number: 9704198526191432198 | Holder: NGUYEN VAN A | Date: 07/15 | OTP: 123456
# Merchant Admin: https://sandbox.vnpayment.vn/merchantv2/
# SIT Testing: https://sandbox.vnpayment.vn/vnpaygw-sit-testing/user/login

# ------------------------------------------------------------------------------
# Social Sign-in (Google & Facebook)
# ------------------------------------------------------------------------------
# Google OAuth 2.0
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Facebook Login
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"

# ------------------------------------------------------------------------------
# Captcha & External Services
# ------------------------------------------------------------------------------
RECAPTCHA_SERVER_KEY="your-google-recaptcha-secret-key"
GEO_LOCATION_API_KEY="your-geolocation-api-key"

# ------------------------------------------------------------------------------
# Frontend Client Exposed Keys (Config & Analytics)
# ------------------------------------------------------------------------------
FE_STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
FE_TINYMCE_API_KEY="your-tinymce-api-key"
FE_RECAPTCHA_CLIENT_KEY="your-recaptcha-site-key"
FE_ANALYTICS_TOKEN="G-XXXXXXXXXX"

# ------------------------------------------------------------------------------
# Google Gemini AI Integration (Chatbot & Assistant)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash-lite"
